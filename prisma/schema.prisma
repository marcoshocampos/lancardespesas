generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoConta {
  CARTAO
  EXTERNA
}

enum MeioPagamento {
  PIX
  DEBITO
  BOLETO
  DINHEIRO
}

enum EscopoLancamento {
  PESSOAL
  CONJUNTO
}

enum OrigemValor {
  POR_PARCELA
  TOTAL
}

enum StatusFatura {
  ABERTA
  CONFERIDA
  TRAVADA
}

enum StatusReembolso {
  PENDENTE
  RECEBIDO
}

model Membro {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  cor          String
  ativo        Boolean  @default(true)
  // Quem fica com o centavo de sobra no rateio 50/50 quando o valor e impar.
  // Exatamente um membro deve ter true — ver src/domain/rateio.ts e
  // docs/decisoes.md ("A sobra de centavos vai sempre para o mesmo membro").
  absorveSobra Boolean  @default(false)
  criadoEm     DateTime @default(now())

  lancamentos Lancamento[]
  rateios     Rateio[]

  @@index([ativo])
}

model Conta {
  id            String    @id @default(cuid())
  nome          String
  tipo          TipoConta
  cor           String
  ativa         Boolean   @default(true)
  diaFechamento Int?
  diaVencimento Int?
  ordem         Int       @default(0)

  lancamentos Lancamento[]
  faturas     Fatura[]

  @@index([ativa, ordem])
}

model Categoria {
  id        String  @id @default(cuid())
  nome      String  @unique
  cor       String
  icone     String?
  arquivada Boolean @default(false)

  lancamentos Lancamento[]
}

model Lancamento {
  id              String           @id @default(cuid())
  descricao       String
  valorCentavos   Int
  origemValor     OrigemValor      @default(POR_PARCELA)
  dataCompra      String // AAAA-MM-DD, sem fuso
  numeroParcelas  Int              @default(1)
  escopo          EscopoLancamento
  meioPagamento   MeioPagamento?
  devedorNome     String?
  statusReembolso StatusReembolso?
  versao          Int              @default(1)
  deletadoEm      DateTime?
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt

  contaId     String
  categoriaId String
  membroId    String?

  conta     Conta     @relation(fields: [contaId], references: [id])
  categoria Categoria @relation(fields: [categoriaId], references: [id])
  membro    Membro?   @relation(fields: [membroId], references: [id])
  parcelas  Parcela[]
  rateios   Rateio[]

  @@index([deletadoEm])
  @@index([contaId, deletadoEm])
}

model Parcela {
  id            String  @id @default(cuid())
  numero        Int
  valorCentavos Int
  competencia   String // AAAA-MM
  cancelada     Boolean @default(false)

  lancamentoId String
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)

  @@unique([lancamentoId, numero])
  @@index([competencia, cancelada])
}

model Rateio {
  id         String @id @default(cuid())
  percentual Float

  lancamentoId String
  membroId     String
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  membro       Membro     @relation(fields: [membroId], references: [id])

  @@unique([lancamentoId, membroId])
}

model Fatura {
  id                 String       @id @default(cuid())
  competencia        String // AAAA-MM
  dataFechamento     String // AAAA-MM-DD
  dataVencimento     String // AAAA-MM-DD
  valorRealCentavos  Int?
  status             StatusFatura @default(ABERTA)
  travadaEm          DateTime?
  travadaPorMembroId String?

  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id])

  @@unique([contaId, competencia])
}

model Auditoria {
  id         String   @id @default(cuid())
  tabela     String
  registroId String
  acao       String
  membroId   String?
  diff       Json
  criadoEm   DateTime @default(now())

  @@index([tabela, registroId])
  @@index([criadoEm])
}
