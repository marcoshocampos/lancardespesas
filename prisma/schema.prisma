generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoConta {
  CARTAO
  EXTERNA
}

enum MeioPagamento {
  PIX
  DEBITO
  BOLETO
  DINHEIRO
}

enum EscopoLancamento {
  PESSOAL
  CONJUNTO
}

enum OrigemValor {
  POR_PARCELA
  TOTAL
}

enum StatusFatura {
  ABERTA
  CONFERIDA
  TRAVADA
}

enum StatusReembolso {
  PENDENTE
  RECEBIDO
}

model Membro {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  cor          String
  ativo        Boolean  @default(true)
  // Quem fica com o centavo de sobra no rateio 50/50 quando o valor e impar.
  // Exatamente um membro deve ter true — ver src/domain/rateio.ts e
  // docs/decisoes.md ("A sobra de centavos vai sempre para o mesmo membro").
  absorveSobra Boolean  @default(false)
  criadoEm     DateTime @default(now())

  lancamentos Lancamento[]
  rateios     Rateio[]
  recorrentes Recorrente[]

  @@index([ativo])
}

model Conta {
  id            String    @id @default(cuid())
  nome          String
  tipo          TipoConta
  cor           String
  ativa         Boolean   @default(true)
  diaFechamento Int?
  diaVencimento Int?
  ordem         Int       @default(0)

  lancamentos Lancamento[]
  faturas     Fatura[]
  recorrentes Recorrente[]

  @@index([ativa, ordem])
}

model Categoria {
  id        String  @id @default(cuid())
  nome      String  @unique
  cor       String
  icone     String?
  arquivada Boolean @default(false)

  lancamentos Lancamento[]
  recorrentes Recorrente[]
}

model Lancamento {
  id              String           @id @default(cuid())
  descricao       String
  valorCentavos   Int
  origemValor     OrigemValor      @default(POR_PARCELA)
  dataCompra      String // AAAA-MM-DD, sem fuso
  numeroParcelas  Int              @default(1)
  // A faixa da compra que ESTE lancamento grava: as parcelas `parcelaInicial`
  // a `parcelaFinal`, inclusive; `parcelaFinal` nulo e ate `numeroParcelas`,
  // que continua sendo o total da compra (o 12 de "4/12"). Editar ou excluir
  // parte de um parcelado divide a faixa em pedacos, cada um um lancamento —
  // ver docs/specs/2026-11-19-trava-por-parcela-design.md.
  parcelaInicial  Int              @default(1)
  parcelaFinal    Int?
  escopo          EscopoLancamento
  meioPagamento   MeioPagamento?
  devedorNome     String?
  // Nao nulo marca o lancamento como reembolso; o valor e sempre PENDENTE.
  // Se ja devolveram e por PARCELA (`Parcela.reembolsoRecebido`): um parcelado
  // se devolve mes a mes. RECEBIDO e legado, e ficou no enum de proposito —
  // ver docs/decisoes.md. Nao grave nem leia RECEBIDO.
  statusReembolso StatusReembolso?
  versao          Int              @default(1)
  deletadoEm      DateTime?
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt

  contaId     String
  categoriaId String
  membroId    String?

  // De qual recorrente e de qual competencia este lancamento nasceu. Os dois
  // sao nulos em lancamento digitado a mao. O par e UNICO: e a trava que impede
  // a mesma recorrente de gerar dois lancamentos no mesmo mes — clique duplo,
  // duas pessoas ao mesmo tempo, ou voltar no mes depois. Como nada e apagado
  // de verdade (deletadoEm), o par sobrevive a exclusao, e e assim que excluir
  // o lancamento gerado vira "pular este mes". O Postgres trata NULL como
  // distinto em indice unico, entao lancamento comum nao e afetado.
  recorrenteId          String?
  competenciaRecorrente String? // AAAA-MM

  conta      Conta       @relation(fields: [contaId], references: [id])
  categoria  Categoria   @relation(fields: [categoriaId], references: [id])
  membro     Membro?     @relation(fields: [membroId], references: [id])
  recorrente Recorrente? @relation(fields: [recorrenteId], references: [id])
  parcelas   Parcela[]
  rateios    Rateio[]

  @@unique([recorrenteId, competenciaRecorrente])
  @@index([deletadoEm])
  @@index([contaId, deletadoEm])
}

// Despesa que se repete todo mes: assinatura, seguro, mensalidade. Nao gera
// nada sozinha — a faixa do Despesas oferece, e alguem clica (docs/decisoes.md).
// Sem dataFim: encerrar e desativar. Sem parcelamento: e uma cobranca por mes,
// e por isso fica fora da projecao de "ja comprometido".
model Recorrente {
  id                String           @id @default(cuid())
  descricao         String
  valorCentavos     Int
  escopo            EscopoLancamento
  diaDoMes          Int
  competenciaInicio String // AAAA-MM, a primeira competencia em que ela vale
  ativa             Boolean          @default(true)
  criadoEm          DateTime         @default(now())

  contaId     String
  categoriaId String
  membroId    String?

  conta       Conta        @relation(fields: [contaId], references: [id])
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  membro      Membro?      @relation(fields: [membroId], references: [id])
  lancamentos Lancamento[]

  @@index([ativa])
}

model Parcela {
  id                String  @id @default(cuid())
  numero            Int
  valorCentavos     Int
  competencia       String // AAAA-MM
  cancelada         Boolean @default(false)
  // So tem sentido em lancamento de reembolso: o terceiro ja devolveu ESTA
  // parcela. Nao muda valor nenhum (docs/regras-de-negocio.md, secao 6).
  reembolsoRecebido Boolean @default(false)

  lancamentoId String
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)

  @@unique([lancamentoId, numero])
  @@index([competencia, cancelada])
}

model Rateio {
  id         String @id @default(cuid())
  percentual Float

  lancamentoId String
  membroId     String
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  membro       Membro     @relation(fields: [membroId], references: [id])

  @@unique([lancamentoId, membroId])
}

model Fatura {
  id                 String       @id @default(cuid())
  competencia        String // AAAA-MM
  dataFechamento     String // AAAA-MM-DD
  dataVencimento     String // AAAA-MM-DD
  valorRealCentavos  Int?
  status             StatusFatura @default(ABERTA)
  travadaEm          DateTime?
  travadaPorMembroId String?

  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id])

  @@unique([contaId, competencia])
}

model Auditoria {
  id         String   @id @default(cuid())
  tabela     String
  registroId String
  acao       String
  membroId   String?
  diff       Json
  criadoEm   DateTime @default(now())

  @@index([tabela, registroId])
  @@index([criadoEm])
}
