# Copie este arquivo para .env.local e preencha com os valores reais.
#
#   cp .env.example .env.local
#
# .env.local esta no .gitignore e nunca deve ser commitado.
# Nao cole nenhum destes valores em conversa, chat ou issue.


# ─────────────────────────────────────────────────────────────────────────────
# Banco de dados — Neon
# ─────────────────────────────────────────────────────────────────────────────
# Onde: console.neon.tech > seu projeto > painel de conexao ("Connect").
# Voce copia a MESMA string duas vezes, alternando o seletor de connection
# pooling. Com o pooling ligado, o host ganha o sufixo "-pooler".
#
# Por que duas: o Prisma rodando em serverless precisa do pooler para nao
# esgotar conexoes, mas as migrations precisam de conexao direta. Usar so a
# string com pooler faz "prisma migrate" falhar de um jeito dificil de
# diagnosticar.

# COM pooler — usada pela aplicacao em tempo de execucao.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-exemplo-12345-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# SEM pooler — usada apenas pelas migrations do Prisma.
DIRECT_URL="postgresql://USUARIO:SENHA@ep-exemplo-12345.sa-east-1.aws.neon.tech/neondb?sslmode=require"


# ─────────────────────────────────────────────────────────────────────────────
# Autenticação — Auth.js v5
# ─────────────────────────────────────────────────────────────────────────────
# AUTH_SECRET assina o cookie de sessao. Nao copie de lugar nenhum: gere com
#
#   npx auth secret
#
# O comando escreve o valor direto no .env.local, entao o segredo nunca passa
# pela tela nem pelo historico do terminal.
AUTH_SECRET=""

# Onde: console.cloud.google.com > APIs e servicos > Credenciais >
# Criar credenciais > ID do cliente OAuth > tipo "Aplicativo da Web".
#
# URIs de redirecionamento autorizados (cadastre os dois):
#   http://localhost:3000/api/auth/callback/google
#   https://SEU-PROJETO.vercel.app/api/auth/callback/google
#
# Origens JavaScript autorizadas:
#   http://localhost:3000
#   https://SEU-PROJETO.vercel.app
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Nao e necessario na Vercel, que detecta a URL sozinha. Preencha apenas se
# rodar atras de proxy ou dominio proprio.
# AUTH_URL="https://despesas.exemplo.com"


# ─────────────────────────────────────────────────────────────────────────────
# Allowlist
# ─────────────────────────────────────────────────────────────────────────────
# Os dois e-mails Google autorizados, separados por virgula, sem espaco.
# Conta Google valida fora desta lista nao entra.
#
# Esta variavel e a fonte da verdade: o seed cria os registros de membro a
# partir dela, e o callback de login confere contra ela. Assim os e-mails
# reais de voces nao ficam escritos em nenhum arquivo versionado.
EMAILS_AUTORIZADOS="nardy@exemplo.com,nick@exemplo.com"
